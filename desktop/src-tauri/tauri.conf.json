{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stemma",
  "identifier": "org.stemma.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stemma",
        "width": 1480,
        "height": 940,
        "minWidth": 760,
        "minHeight": 440,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "create": false
      },
      {
        "label": "machine",
        "title": "Stemma \u2014 Settings",
        "url": "index.html?settings",
        "width": 820,
        "height": 640,
        "minWidth": 680,
        "minHeight": 480,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../node_modules/@stemma-math/design/icons/apple-touch-icon.png"]
  }
}
