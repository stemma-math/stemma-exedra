{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "web/**",
      "desktop/**",
      "!web/build",
      "!web/.svelte-kit",
      "!desktop/dist",
      "!desktop/src-tauri/gen"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "html": {
    "experimentalFullSupportEnabled": true
  },
  "overrides": [
    {
      "includes": ["desktop/**/*.svelte"],
      "html": {
        "formatter": {
          "enabled": true,
          "indentScriptAndStyle": true,
          "selfCloseVoidElements": "always"
        }
      }
    }
  ],
  "linter": {
    "rules": {
      "recommended": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
